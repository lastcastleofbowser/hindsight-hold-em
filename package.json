{
  "name": "hindsight-hold-em",
  "private": true,
  "version": "0.5.0",
  "description": "Offline-first Texas Hold'em trainer with live probabilities and an AI coach.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.12.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sql.js": "1.4.9",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
