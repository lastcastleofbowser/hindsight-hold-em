# Generate once with: openssl rand -hex 32
# Keep this key stable and private; losing it makes the encrypted DB unreadable.
DATA_ENCRYPTION_KEY=

# Public origin used in password reset links.
APP_URL=http://localhost:8787

# SMTP is required in production. Without SMTP, development logs verification and reset links to the server console.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=